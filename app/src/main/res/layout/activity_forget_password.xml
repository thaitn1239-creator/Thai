<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo UTH -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UTH"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1F604C"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNIVERSITY OF TRANSPORT\nHOCHIMINH CITY"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#C49A45"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartTasks"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4299E1"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forget Password?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your Email, we will send you a verification code."
            android:textSize="13sp"
            android:textColor="#718096"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- EditText Email -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Your Email"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <!-- Nút Next -->
        <Button
            android:id="@+id/btnNext1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Next"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:backgroundTint="#4299E1"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="30dp"/>

        <!-- Khung hiển thị kết quả từ màn 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_result_box"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvResultEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email"
                android:textSize="16sp"
                android:textColor="#E53E3E"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvResultOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="otp"
                android:textSize="16sp"
                android:textColor="#E53E3E"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvResultPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pass"
                android:textSize="16sp"
                android:textColor="#E53E3E"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(từ màn hình 4)"
                android:textSize="14sp"
                android:textColor="#E53E3E"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>